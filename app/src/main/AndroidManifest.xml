<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" />

    <!-- 摄像头动作捕捉需要的能力与权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_foreground"
        android:supportsRtl="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.Ble_Activity"></activity>
        <service android:name="com.zxw.service.BluetoothLeService" android:enabled="true"></service>
        <activity android:name=".ui.DebugActivity"
            android:resizeableActivity="true"/>

        <!-- 人体姿态捕捉模块 -->
        <activity
            android:name=".fitness.ui.ProfileActivity"
            android:screenOrientation="portrait"
            android:theme="@style/FitnessTheme" />
        <activity
            android:name=".fitness.ui.ExerciseListActivity"
            android:screenOrientation="portrait"
            android:theme="@style/FitnessTheme" />
        <activity
            android:name=".fitness.ui.HistoryActivity"
            android:screenOrientation="portrait"
            android:theme="@style/FitnessTheme" />
        <activity
            android:name=".fitness.ui.TrainingActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:theme="@style/FitnessTheme" />
        <activity
            android:name=".fitness.ui.ReplayActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:theme="@style/FitnessTheme" />
    </application>

</manifest>
