<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/history_bg_card"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="24dp"
    android:paddingRight="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="🌟"
        android:textSize="38sp" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="第一颗星星在等你"
        android:textColor="@color/history_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="和家长选个喜欢的动作，留下第一条足迹吧。"
        android:textColor="@color/history_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btnEmptyAction"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/history_bg_chip_selected"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:text="选择喜欢的运动"
        android:textColor="@color/history_dark_text"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
